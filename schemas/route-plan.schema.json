{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipt.local/schemas/route-plan",
  "title": "Route plan",
  "description": "The router's proposed plan for a request. The plan is returned even when the budget does not fit; admission enforces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request",
    "workflow_id",
    "mode",
    "risk_tier",
    "selected_roles",
    "omitted_roles",
    "stages",
    "predicates",
    "budget_check",
    "explicit"
  ],
  "properties": {
    "request": {
      "type": "string"
    },
    "workflow_id": {
      "type": "string",
      "description": "Workflow id or name.",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "focused",
        "standard",
        "deep"
      ]
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3"
      ]
    },
    "selected_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "A role id from registry/agents.json, or 'human-owner'.",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "omitted_roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/omitted_role"
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage_decision"
      }
    },
    "predicates": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "Predicate name to evaluated value."
    },
    "budget_check": {
      "type": "object",
      "required": [
        "fits"
      ],
      "properties": {
        "fits": {
          "type": "boolean"
        },
        "overflow": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "explicit": {
      "type": [
        "boolean",
        "object"
      ],
      "description": "Explicit workflow or role selection, if any."
    },
    "confidence": {
      "type": "string",
      "enum": [
        "exact",
        "keyword",
        "fallback"
      ]
    },
    "action_kind": {
      "type": "string",
      "enum": [
        "analysis",
        "proposed_change",
        "local_execution",
        "external_action"
      ]
    },
    "human_action_request": {
      "type": "boolean",
      "description": "True when the request is an external action (R3): no executable stage."
    }
  },
  "$defs": {
    "omitted_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "reason"
      ],
      "properties": {
        "role_id": {
          "type": "string",
          "description": "A role id from registry/agents.json, or 'human-owner'.",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "stage_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "role_id",
        "included",
        "reason"
      ],
      "properties": {
        "stage_id": {
          "type": "string",
          "minLength": 1
        },
        "role_id": {
          "type": "string",
          "description": "A role id from registry/agents.json, or 'human-owner'.",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "included": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "satisfied_by_version_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Current accepted artifact that pruned the stage."
        }
      }
    }
  }
}
